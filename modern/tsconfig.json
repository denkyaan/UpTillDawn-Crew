{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/actions/auth": [
        "src/compat/auth-actions.ts"
      ],
      "@/lib/server-locale": [
        "src/compat/server-locale.ts"
      ],
      "@/lib/supabase/crew-server": [
        "src/compat/crew-browser.ts"
      ],
      "@/*": [
        "../*"
      ],
      "next/link": [
        "src/compat/link.tsx"
      ],
      "next/image": [
        "src/compat/image.tsx"
      ],
      "next/navigation": [
        "src/compat/navigation.ts"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "lucide-react": [
        "node_modules/lucide-react"
      ],
      "class-variance-authority": [
        "node_modules/class-variance-authority"
      ],
      "clsx": [
        "node_modules/clsx"
      ],
      "tailwind-merge": [
        "node_modules/tailwind-merge"
      ],
      "@radix-ui/react-label": [
        "node_modules/@radix-ui/react-label"
      ],
      "@radix-ui/react-slot": [
        "node_modules/@radix-ui/react-slot"
      ],
      "next-themes": [
        "node_modules/next-themes"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
