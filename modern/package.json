{
  "name": "@uptilldawn/local-first-candidate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8788",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "budget": "node scripts/bundle-budget.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler-candidate-dry-run",
    "inventory": "node scripts/inventory.mjs",
    "api:test": "node scripts/build-native-auth.mjs && node --test tests/*.test.mjs",
    "browser:test": "node tests/browser-smoke.mjs",
    "rpc:contract": "node scripts/rpc-contract.mjs",
    "browser:qa": "node tests/browser-auth-qa.mjs",
    "sessions:qa": "node tests/qa-30-sessions.mjs",
    "login:visual-parity": "node tests/login-parity-qa.mjs",
    "login:cutover-gate": "node scripts/login-cutover-gate.mjs",
    "prebuild": "node scripts/build-native-auth.mjs && node scripts/prepare-original-assets.mjs",
    "browser:deep-qa": "node tests/deep-route-parity-qa.mjs",
    "bundle:seven": "node scripts/seven-bundle-readiness.mjs",
    "cutover:gate": "node scripts/seven-bundle-readiness.mjs --enforce-cutover",
    "worker:standalone-check": "node scripts/standalone-release-plan.mjs --prepare-main-dry-run && wrangler deploy --dry-run --config .wrangler-standalone-main-preflight.jsonc --outdir .wrangler-standalone-main-preflight"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.106.2",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "^4.11.0",
    "lucide-react": "0.564.0",
    "next-themes": "0.4.6",
    "prettier": "3.9.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.12.0",
    "sonner": "1.7.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.1",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "4.136.3"
  }
}
