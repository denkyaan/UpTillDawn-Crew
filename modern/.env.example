# Only public Supabase client credentials; never commit the service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Worker bindings (set via Wrangler dev vars / deployment environment)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Stays off until server/RLS and seven-role write parity are verified.
VITE_MIGRATION_ALLOW_WRITES=false

# Server-only operator-managed OAuth application registration.
# End users only sign in with their providers; never ask them for client secrets.
# On candidate: remains disabled pending authorized provider consent E2E.
UPT_MIGRATION_OAUTH_ENABLED=false
UPT_PROVIDER_OAUTH_ORIGIN=https://EXACT_REGISTERED_APP_ORIGIN
UPT_INTEGRATION_ENCRYPTION_KEY=SERVER_ONLY_BASE64_32_RANDOM_BYTES
UPT_SUMUP_OAUTH_CLIENT_ID=SERVER_ONLY_APP_CLIENT_ID
UPT_SUMUP_OAUTH_CLIENT_SECRET=SERVER_ONLY_APP_CLIENT_SECRET
UPT_BILLIT_OAUTH_CLIENT_ID=SERVER_ONLY_APP_CLIENT_ID
UPT_BILLIT_OAUTH_CLIENT_SECRET=SERVER_ONLY_APP_CLIENT_SECRET
UPT_BILLIT_OAUTH_ENV=sandbox

# Weeztix admission is a provider write. OFF by default; enable only after
# isolated signed entrant/scanner QA, config setup and authorized Main cutover.
VITE_MIGRATION_SCANNING_ENABLED=false
UPT_MIGRATION_SCANNING_ENABLED=false
UPT_SCANNER_ORIGIN=https://EXACT_MAIN_TEST_ORIGIN
# Reuse the SAME server-side UPT_INTEGRATION_ENCRYPTION_KEY as the existing app.
# User connects Weeztix from the authorized Administration ticketing screen.
