# Uptilldawn local environment
# Copy to .env.local and replace placeholders. NEVER commit secrets.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, server-only geocoding
GEOAPIFY_API_KEY=

# One UpTillDawn test event only; enabling triggers REAL online Weeztix scan-in
WEEZTIX_SCANNING_ENABLED=false
WEEZTIX_ACTIVE_EVENT_ID=
WEEZTIX_ACCESS_TOKEN=

# Provider credentials are configuration only until their E2E adapters are validated
BILLIT_SANDBOX_PARTY_ID=
BILLIT_SANDBOX_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_API_KEY=
DOCUMENSO_BASE_URL=
DOCUMENSO_API_KEY=
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=

# Shared Admin + Administration encrypted provider configuration.
# 32 cryptographically random bytes, encoded as base64. Store as a Worker Secret.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
UPT_INTEGRATION_ENCRYPTION_KEY=
